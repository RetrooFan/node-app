{
  "name": "my-app",
  "version": "1.0",
  "main": "server.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "prod": "node .",
    "dev": "tsx src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
